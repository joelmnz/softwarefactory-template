{
  "name": "mastra-factory",
  "version": "0.1.0",
  "description": "Mastra Factory: an agent-powered software delivery environment. Intake GitHub/Linear issues, work them with coding agents, and ship pull requests — all from your own deployable web app.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "mastra factory dev --dir src/mastra",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "check": "tsc --noEmit",
    "build": "mastra build --dir src/mastra",
    "start": "varlock run -- mastra start",
    "deploy": "mastra deploy"
  },
  "dependencies": {
    "@mastra/auth-better-auth": "1.1.7",
    "@mastra/auth-workos": "1.6.6",
    "@mastra/code-sdk": "1.13.0",
    "@mastra/core": "1.77.0",
    "@mastra/e2b": "0.14.0",
    "@mastra/factory": "0.22.0",
    "@mastra/libsql": "1.26.1",
    "@mastra/memory": "1.37.1",
    "@mastra/pg": "1.31.1",
    "@mastra/platform-workspace": "1.8.0",
    "@mastra/redis-streams": "0.6.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "mastra": "1.34.1",
    "typescript": "^5.9.2",
    "varlock": "^1.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
